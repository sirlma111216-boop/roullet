{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "classroom-marble-race",
  "main": "src/index.ts",

  // 이 날짜의 런타임 동작을 고정한다. 올릴 때는 변경 내역을 확인하고 배포 검증을 다시 한다.
  "compatibility_date": "2026-09-20",

  "assets": {
    // 화면(apps/web)을 빌드한 결과. 먼저 `npm run build` 를 해야 한다.
    "directory": "../web/dist",
    "binding": "ASSETS",

    // 새로고침 라우팅: /teacher/... 같은 주소를 직접 열어도 index.html 을 준다.
    "not_found_handling": "single-page-application",

    // ★ 모든 요청을 Worker 가 먼저 본다.
    //
    // 경로 몇 개만 적어 두면(예: ["/api/*", "/ws"]) 나머지는 Worker 를 **아예 거치지 않고**
    // 정적 자산 계층이 바로 내보낸다. 그러면 Worker 가 붙이는 보안 헤더
    // (CSP·frame-ancestors·nosniff·referrer-policy)가 화면 파일에 하나도 안 붙는다.
    // 실제로 그렇게 배포되어 있었고, 운영 주소의 응답에 보안 헤더가 전혀 없었다.
    //
    // 정적 파일은 여전히 env.ASSETS 가 내보내고, Worker 는 헤더만 씌운다.
    // frame-ancestors 는 환경 변수로 정하므로 코드에서 붙일 수밖에 없다
    // (_headers 파일은 정적 자산 전용이라 환경 변수를 읽지 못한다).
    "run_worker_first": true
  },

  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },

  // new_sqlite_classes 여야 무료 요금제에서 쓸 수 있다. new_classes 는 유료 전용이다.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],

  "observability": { "enabled": true },

  // 비밀이 아닌 설정만 여기 둔다. 실제 비밀은 `wrangler secret put` 으로 넣는다.
  // INTEGRATION_SECRETS 는 secret 이다 — 여기에 적지 마라.
  //
  // EMBED_ALLOWED_ORIGINS: 이 화면을 iframe 안에 넣어도 되는 부모 앱 주소.
  // 그대로 CSP frame-ancestors 에 들어간다. 비어 있으면 아무도 넣을 수 없고,
  // 붙이려는 앱에서는 **하얀 화면만** 나온다(오류 메시지도 안 뜬다).
  //
  // 여러 개는 **쉼표로** 구분한다(코드가 split(',') 로 읽는다).
  // 새 수업 앱에 붙일 때는 그 앱의 주소를 뒤에 쉼표로 이어 붙이고 다시 배포하면 된다.
  // local 모드(서버 없이 넣기)에서도 이것만은 필요하다 — 브라우저가 막기 때문이다.
  "vars": {
    "EMBED_ALLOWED_ORIGINS": "https://nc1395.labbitory.com,https://scienced.labbitory.com"
  }
}

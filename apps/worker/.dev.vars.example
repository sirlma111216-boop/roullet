# 로컬 개발용 비밀. 이 파일을 .dev.vars 로 복사해 값을 채운다.
# .dev.vars 는 git 에 올리지 않는다(.gitignore 에 들어 있다).
#
# 운영에서는 이 값들을 `wrangler secret put <이름>` 으로 넣는다.

# 부모 수업 앱 연동. 수업 앱 서버의 SHARED_SECRET 과 **같은 값**이어야 한다.
# resultUrl 은 확정된 결과를 서명해 보낼 주소, origins 는 iframe 을 띄울 수 있는 부모 주소다.
INTEGRATION_SECRETS={"demo-class":{"secret":"local-dev-secret-change-me-0123456789","resultUrl":"http://127.0.0.1:5180/api/activity/result","origins":["http://127.0.0.1:5180"]}}

# iframe 으로 띄울 수 있는 부모 origin (쉼표로 구분). CSP frame-ancestors 에 그대로 들어간다.
EMBED_ALLOWED_ORIGINS=http://127.0.0.1:5180
